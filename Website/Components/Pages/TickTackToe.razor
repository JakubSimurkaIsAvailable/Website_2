@page "/ticktacktoe"
@rendermode InteractiveServer

<PageTitle>Tic Tac Toe</PageTitle>

<section class="pixel-shell pixel-panel">
<p class="pixel-kicker">Arcade board</p>
<h1>@(!_victory ? "Tic Tac Toe" : $"Player {_winner} won!")</h1>

<div class="board">
    @for (int i = 0; i < 9; i++)
    {
        var index = i;
        <button class="cell" @onclick="() => Handle_Turn(index)" style="color: @GetColor(GetValue(index))">
            @GetValue(index) 
        </button>
    }
</div>

<button class="pixel-btn" @onclick="() => Reset()">Restart</button>
</section>

@code {
    private string _player = "X";
    private string[] _board = new string[9];
    private string _winner = "";
    private bool _victory = false;
    private int _turn = 0;

    
    private string GetColor(string value) => value switch
    {
        "X" => "greenyellow",
        "O" => "mediumvioletred",
        _   => "grey"
    };
    
    private void Handle_Turn(int index)
    {
        if (_victory || _board[index] == "X" || _board[index] == "O")
        {
            return;
        }

        string temp = _player;
        Take_Turn(index, temp);
        GameOver(temp);

        if (!_victory && temp == "X")
        {
            AI_turn();
        }
    }
    private void Take_Turn(int index, string tempPlayer)
    {
        if (_board[index] == "X" || _board[index] == "O")
        {
            return;
        }
        
        if (_player.Equals("X"))
        {
            _player = "O";
        }
        else
        {
            _player = "X";
        }
        _board[index] = tempPlayer;
    }

    private string GetValue(int index)
    {
        if (_board[index] == null)
        {
            return (index + 1).ToString();
        }
        return _board[index];
    }

    private void GameOver(string player)
    {
        for (int i = 0; i < 3; i++)
        {
            if (_board[3 * i] != null && _board[3 * i] == _board[3 * i + 1] && _board[3 * i] == _board[3 * i + 2])
                _victory = true;
        }

        for (int i = 0; i < 3; i++)
        {
            if (_board[i] != null && _board[i] == _board[i + 3] && _board[i] == _board[i + 6])
                _victory = true;
        }

        if (_board[0] != null && _board[0] == _board[4] && _board[0] == _board[8])
            _victory = true;
        if (_board[2] != null && _board[2] == _board[4] && _board[2] == _board[6])
            _victory = true;
        
        if (_victory)
        {
            _winner = player;
        }
    }

    private void Reset()
    {
        _board = new string[9];
        _victory = false;
        _player = "X";
        _turn = 0;
    }

    private void AI_turn()
    {
        List<int> xSpaces = new List<int>();
        List<int> oSpaces = new List<int>();

        for (int i = 0; i < _board.Length; i++)
        {
            if (_board[i] == "X")
            {
                xSpaces.Add(i);
            }
            else if (_board[i] == "O")
            {
                oSpaces.Add(i);
            }
        }

        // Opening: one X, no O. Rotate until that X sits at 0 (corner) or 1 (edge).
        if (xSpaces.Count != 1 || oSpaces.Count != 0)
        {
            Block();
            return;
        }

        int rotations = CalculateRotations(xSpaces, oSpaces);
        string[] fakeBoard = RotateFakeBoard(_board, rotations);

        int canonicalMove;
        if (fakeBoard[4] == "X")
        {
            canonicalMove = 0;
        }
        else
        {
            canonicalMove = 4;
        }

        int realMove = MapIndexBack(canonicalMove, rotations);
        Take_Turn(realMove, "O");
        GameOver("O");
    }

    private static bool IsCanonicalX(IEnumerable<int> xSpaces)
    {
        return xSpaces.Any(x => x == 0 || x == 1);
    }

    private int CalculateRotations(List<int> xSpaces, List<int> oSpaces)
    {
        // Center never moves under 90° turns, so there is no path to 0 or 1.
        if (xSpaces.Count == 1 && xSpaces[0] == 4)
        {
            return 0;
        }

        // At most 4 quarter-turns. Corners cycle 0-2-8-6, edges cycle 1-5-7-3.
        for (int rotations = 0; rotations < 4; rotations++)
        {
            if (IsCanonicalX(xSpaces))
            {
                return rotations;
            }

            for (int i = 0; i < xSpaces.Count; i++)
            {
                xSpaces[i] = RotateNumber(xSpaces[i]);
            }

            for (int i = 0; i < oSpaces.Count; i++)
            {
                oSpaces[i] = RotateNumber(oSpaces[i]);
            }
        }

        return 0;
    }

    private int RotateNumber(int number, bool dir = true)
    {
        int x = number / 3;
        int y = number % 3;
        int newX;
        int newY;
        if (dir)
        {
            newX = y;
            newY = 2 - x;
        }
        else
        {
            newX = 2 - y;
            newY = x;
        }

        return newX * 3 + newY;
    }

    private string[] RotateFakeBoard(string[] board, int rotations, bool dir = true)
    {
        string[] current = (string[])board.Clone();

        for (int j = 0; j < rotations; j++)
        {
            string[] next = new string[9];
            for (int i = 0; i < current.Length; i++)
            {
                next[RotateNumber(i, dir)] = current[i];
            }

            current = next;
        }

        return current;
    }

    private int MapIndexBack(int canonicalIndex, int rotations)
    {
        int index = canonicalIndex;
        for (int i = 0; i < rotations; i++)
        {
            index = RotateNumber(index, dir: false);
        }

        return index;
    }
    private static readonly int[][] WinLines =
    {
        new[] { 0, 1, 2 }, new[] { 3, 4, 5 }, new[] { 6, 7, 8 }, // rows
        new[] { 0, 3, 6 }, new[] { 1, 4, 7 }, new[] { 2, 5, 8 }, // columns
        new[] { 0, 4, 8 }, new[] { 2, 4, 6 }                     // diagonals
    };

    private readonly Random _rng = new Random();

// Returns the empty index that completes a line for `mark`, or -1 if none.
    private int FindWinningMove(string mark)
    {
        foreach (int[] line in WinLines)
        {
            int markCount = 0;
            int emptyIndex = -1;

            foreach (int i in line)
            {
                if (_board[i] == mark)
                {
                    markCount++;
                }
                else if (string.IsNullOrEmpty(_board[i]))
                {
                    emptyIndex = i;
                }
            }

            if (markCount == 2 && emptyIndex != -1)
            {
                return emptyIndex;
            }
        }

        return -1;
    }

    private void Block()
    {
        // 1. Block the player if X is about to win
        int move = FindWinningMove("O");

        // 2. Otherwise take a winning move for the AI
        if (move == -1)
        {
            move = FindWinningMove("X");
        }

        // 3. Otherwise pick a random empty cell
        if (move == -1)
        {
            List<int> empty = new List<int>();
            for (int i = 0; i < _board.Length; i++)
            {
                if (string.IsNullOrEmpty(_board[i]))
                {
                    empty.Add(i);
                }
            }

            if (empty.Count == 0)
            {
                return; // board is full
            }

            move = empty[_rng.Next(empty.Count)];
        }

        Take_Turn(move, "O");
        GameOver("O");
    }
}