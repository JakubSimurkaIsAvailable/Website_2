@page "/ticktacktoe"
@rendermode InteractiveServer

<PageTitle>Tic Tac Toe</PageTitle>

<section class="pixel-shell pixel-panel">
<p class="pixel-kicker">Arcade board</p>
<h1>@(!_victory ? "Tic Tac Toe" : $"Player {_winner} won!")</h1>

<div class="board">
    @for (int i = 0; i < 9; i++)
    {
        var index = i;
        <button class="cell" @onclick="() => Handle_Turn(index)">
            @GetValue(index)
        </button>
    }
</div>

<button class="pixel-btn" @onclick="() => Reset()">Restart</button>
</section>

@code {
    private string _player = "X";
    private string[] _board = new string[9];
    private string _winner = "";
    private bool _victory = false;
    private int _turn = 0;

    private void Handle_Turn(int index)
    {
        if (_victory)
        {
            return;
        }
        string temp = _player;
        Take_Turn(index, temp);
        GameOver(temp);
    }
    private void Take_Turn(int index, string tempPlayer)
    {
        if (_board[index] == "X" || _board[index] == "O")
        {
            return;
        }
        
        if (_player.Equals("X"))
        {
            _player = "O";
        }
        else
        {
            _player = "X";
        }
        _board[index] = tempPlayer;
    }

    private string GetValue(int index)
    {
        return _board[index];
    }

    private void GameOver(string player)
    {
        for (int i = 0; i < 3; i++)
        {
            if (_board[3 * i] != null && _board[3 * i] == _board[3 * i + 1] && _board[3 * i] == _board[3 * i + 2])
                _victory = true;
        }

        for (int i = 0; i < 3; i++)
        {
            if (_board[i] != null && _board[i] == _board[i + 3] && _board[i] == _board[i + 6])
                _victory = true;
        }

        if (_board[0] != null && _board[0] == _board[4] && _board[0] == _board[8])
            _victory = true;
        if (_board[2] != null && _board[2] == _board[4] && _board[2] == _board[6])
            _victory = true;
        
        if (_victory)
        {
            _winner = player;
        }
    }

    private void Reset()
    {
        _board = new string[9];
        _victory = false;
        _player = "X";
        _turn = 0;
    }

    private void AI_turn()
    {
        List<int> _Xspaces = new List<int>();
        List<int> _Ospaces = new List<int>();
        for (int i = 0; i < _board.Length; i++)
        {
            if (_board[i] == "X")
            {
                _Xspaces.Add(i);
            }
            else if (_board[i] == "O")
            {
                _Ospaces.Add(i);
            }
        }

        var fake_board = _board;
        if (_turn == 0)
        {
            
        }
    }

    private void Block()
    {
        
    }
}