@page "/camera"
@rendermode InteractiveServer
@using Website.Components.Pages.SubPages

<PageTitle>Gesture recognition</PageTitle>

<section class="pixel-shell pixel-panel">
    <p class="pixel-kicker">Live capture</p>
    <h1>Hand tracker</h1>
    <p class="pixel-copy">Start the camera, then hold a sign in frame. Landmarks draw on top of the video.</p>

    <CameraFeed OnSignRecognized="HandleSign" />

    <div class="sign-hud">
        <p class="pixel-label">Recognized sign</p>
        <h4 class="pixel-readout">@recognizedSign</h4>
    </div>
</section>

@code {
    private string recognizedSign = "Waiting...";

    private void HandleSign(string sign) => recognizedSign = sign;
}