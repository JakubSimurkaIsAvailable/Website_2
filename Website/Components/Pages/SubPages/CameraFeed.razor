@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="camera-stage">
    <video @ref="VideoElement"
           id="video"
           autoplay
           playsinline
           muted></video>
    <canvas id="overlay"></canvas>
</div>

@if (ShowStartButton)
{
    <button class="pixel-btn start-camera" @onclick="StartCameraAsync">
        Start Camera
    </button>
}

@code {
    private ElementReference VideoElement;
    private IJSObjectReference? module;
    private DotNetObjectReference<CameraFeed>? dotNetReference;

    /// <summary>Raised whenever the model recognizes a sign.</summary>
    [Parameter] public EventCallback<string> OnSignRecognized { get; set; }

    /// <summary>Set to false if the host page wants to start the camera itself.</summary>
    [Parameter] public bool ShowStartButton { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./lib/custom/dist/js/gesture_recognition.js");
        }
    }

    // Public so a host page can call it via @ref if it wants its own button.
    public async Task StartCameraAsync()
    {
        if (module is null)
        {
            Console.WriteLine("JavaScript module has not loaded.");
            return;
        }

        dotNetReference ??= DotNetObjectReference.Create(this);

        await module.InvokeVoidAsync("startCamera", VideoElement, dotNetReference);
    }

    [JSInvokable]
    public async Task SetRecognizedSign(string sign)
    {
        await OnSignRecognized.InvokeAsync(sign);
    }

    public async ValueTask DisposeAsync()
    {
        dotNetReference?.Dispose();

        if (module is not null)
        {
            try { await module.DisposeAsync(); }
            catch { /* circuit may already be gone */ }
        }
    }
}