@page "/camerafeed"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="camera-stage">
    <video @ref="VideoElement"
           id="video"
           autoplay
           playsinline
           muted></video>
    <canvas id="overlay"></canvas>
</div>

<div class="sign-hud">
    <p class="pixel-label">Recognized sign</p>
    <h4 class="pixel-readout">@RecognizedSign</h4>
</div>

<button class="pixel-btn start-camera" @onclick="StartCameraAsync">
    Start Camera
</button>

@code {
    private ElementReference VideoElement;

    private IJSObjectReference? module;
    private DotNetObjectReference<CameraFeed>? dotNetReference;

    private string RecognizedSign = "Waiting...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./lib/custom/dist/js/gesture_recognition.js");
        }
    }

    private async Task StartCameraAsync()
    {
        if (module is null)
        {
            Console.WriteLine("JavaScript module has not loaded.");
            return;
        }

        dotNetReference ??= DotNetObjectReference.Create(this);

        await module.InvokeVoidAsync(
            "startCamera",
            VideoElement,
            dotNetReference);
    }

    [JSInvokable]
    public void SetRecognizedSign(string sign)
    {
        RecognizedSign = sign;

        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        dotNetReference?.Dispose();

        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch
            {
                // Component may already have been disposed.
            }
        }
    }
}
