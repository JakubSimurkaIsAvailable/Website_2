@page "/camerafeed"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<h3>Live Camera Feed</h3>

<div class="camera-container">
    <canvas id="overlay">
        
    </canvas>
    
    <video @ref="VideoElement"
           id="video"
           autoplay
           playsinline>
    </video>
</div>

<div class="mt-3">
    <h4>Recognized sign: @RecognizedSign</h4>
</div>

<button class="btn btn-primary mt-2" @onclick="StartCameraAsync">
    Start Camera
</button>

@code {
    private ElementReference VideoElement;

    private IJSObjectReference? module;
    private DotNetObjectReference<CameraFeed>? dotNetReference;

    private string RecognizedSign = "Waiting...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./lib/custom/dist/js/gesture_recognition.js");
        }
    }

    private async Task StartCameraAsync()
    {
        if (module is null)
        {
            Console.WriteLine("JavaScript module has not loaded.");
            return;
        }

        dotNetReference ??= DotNetObjectReference.Create(this);

        await module.InvokeVoidAsync(
            "startCamera",
            VideoElement,
            dotNetReference);
    }

    [JSInvokable]
    public void SetRecognizedSign(string sign)
    {
        RecognizedSign = sign;

        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        dotNetReference?.Dispose();

        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch
            {
                // Component may already have been disposed.
            }
        }
    }
}